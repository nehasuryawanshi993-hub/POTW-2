//move zeroes

class Solution {
    public void moveZeroes(int[] nums) {
        int n=nums.length;
        int ind=0;
        for(int i=0;i<n;i++){
            if(nums[i]==0){
                ind=i;
                break;
            }
        }
        int j=ind+1;
        while(ind<=j && j<n){
            if(nums[ind]==0 && nums[j]!=0){
                int temp=nums[ind];
                nums[ind]=nums[j];
                nums[j]=temp;
               
                 ind++;
            }
           
            j++;
        }
       
      
    }
}

//matrix diagonal solution

class Solution {
    public int diagonalSum(int[][] mat) {
        int n=mat.length;
        int m=mat[0].length;
        int sum=0;
        for(int i=0;i<n;i++){
            for(int j=0;j<n;j++){
            if(i==j || j==(n-i-1)){
sum+=mat[i][j];
            }
          
        }
    }
    return sum;
    }

}
